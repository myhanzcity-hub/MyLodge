{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/intro.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/main-pc-handoff-20260930": false
    }
  },
  "redirects": [
    {
      "source": "/domestic-villas.html",
      "destination": "/parks/domestic-villas.html",
      "permanent": false
    },
    {
      "source": "/business-valley.html",
      "destination": "/parks/business-valley.html",
      "permanent": false
    },
    {
      "source": "/owners.html",
      "destination": "/parks/owners.html",
      "permanent": false
    }
  ]
}
